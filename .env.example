# Copy this file to .env for local development with `netlify dev`
# In production, set these in your Netlify dashboard under Site > Environment variables

FLICKR_API_KEY=your_flickr_api_key_here
FLICKR_USER_ID=your_flickr_user_id_here

# Comma-separated list of photoset (album) IDs to display, in order.
# Leave empty to show all albums.
FLICKR_ALBUM_IDS=72157600000000001,72157600000000002
